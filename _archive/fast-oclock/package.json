{
	"name": "fast-oclock",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"cap": "capacitor",
		"capacitor:copy:before": "yarn format && yarn check",
		"capacitor:copy:after": "yarn cap open $CAPACITOR_PLATFORM_NAME",
		"capacitor:sync:before": "yarn lint && yarn build",
		"ios": "yarn cap run ios",
		"live:ios": "yarn cap sync ios; yarn dev",
		"android": "yarn cap run android",
		"live:android": "yarn cap sync android; yarn dev"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.1.0",
		"@capacitor/core": "^7.1.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"carbon-preprocess-svelte": "^0.11.11",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0"
	},
	"packageManager": "yarn@4.8.1",
	"volta": {
		"node": "22.14.0"
	},
	"dependencies": {
		"@capacitor-community/safe-area": "^7.0.0-alpha.1",
		"@capacitor/android": "^7.1.0",
		"@capacitor/ios": "^7.1.0",
		"carbon-components-svelte": "^0.88.4",
		"carbon-icons-svelte": "^13.3.0"
	}
}