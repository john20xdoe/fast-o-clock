{
	"name": "fast-o-clock",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"description": "simple fasting tracker",
	"repository": "",
	"license": "ISC",
	"engineStrict": true,
	"engines": {
		"node": ">=20.19.0"
	},
	"volta": {
		"node": "22.14.0"
	},
	"browserslist": [
		"IOS >= 15",
		"Safari >= 15",
		"last 5 Chrome versions",
		"last 5 Firefox versions"
	],
	"scripts": {
		"cap": "capacitor",
		"postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"build:prod": "cross-env NODE_ENV=production yarn build",
		"capacitor:copy:before": "yarn format && yarn check",
		"capacitor:copy:after": "yarn cap open $CAPACITOR_PLATFORM_NAME",
		"capacitor:sync:before": "yarn lint && yarn build",
		"ios": "yarn cap sync ios && yarn cap run ios",
		"ios:live": "cross-env LIVE_RELOAD=true yarn cap copy ios && yarn dev",
		"android": "yarn cap sync android && yarn cap run android",
		"android:live": "cross-env LIVE_RELOAD=true yarn cap copy android && yarn dev"
	},
	"dependencies": {
		"@capacitor/android": "^7.2.0",
		"@capacitor/app": "^7.0.1",
		"@capacitor/browser": "^7.0.1",
		"@capacitor/core": "^7.1.0",
		"@capacitor/ios": "^7.2.0",
		"@capacitor/keyboard": "^7.0.1",
		"@capacitor/splash-screen": "^7.0.1",
		"@capacitor/status-bar": "^7.0.1",
		"dom7": "^4.0.6",
		"framework7": "^8.3.4",
		"framework7-icons": "^5.0.5",
		"framework7-svelte": "^8.3.4",
		"material-icons": "^1.13.14",
		"skeleton-elements": "^4.0.1",
		"svelte": "^5.25.6",
		"swiper": "^11.2.6"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.1.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tsconfig/svelte": "^5.0.4",
		"cordova-res": "^0.15.4",
		"cpy-cli": "^5.0.0",
		"cross-env": "^7.0.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"less": "^4.2.2",
		"postcss-preset-env": "^10.1.5",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte-check": "^4.0.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.29.0",
		"vite": "^6.2.5",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"packageManager": "yarn@4.8.1"
}
